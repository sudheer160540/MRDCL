# Set these only before the first application start (the first start creates the accounts).
# Use strong unique values and keep the real values out of version control.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
TEAM1_PASSWORD=replace-with-a-strong-team-1-password
TEAM2_PASSWORD=replace-with-a-strong-team-2-password
AUTHORITY_PASSWORD=replace-with-a-strong-viewer-password
PORT=5890
